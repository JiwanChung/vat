# --- Tunnel Shortcuts ---

# Forward pgAdmin to production primary
Host tunnel-pgadmin
  HostName bastion-east.acme.com
  User ops
  IdentityFile ~/.ssh/id_ed25519_acme
  Port 2222
  LocalForward 15432 10.1.20.10:5432
  LocalForward 16379 10.1.30.10:6379
  RequestTTY no
  SessionType none

# SOCKS proxy through bastion for internal services
Host tunnel-socks
  HostName bastion-east.acme.com
  User ops
  IdentityFile ~/.ssh/id_ed25519_acme
  Port 2222
  DynamicForward 1080
  RequestTTY no
  SessionType none
