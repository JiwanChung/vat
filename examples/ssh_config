# ===========================================
# SSH Client Configuration (~/.ssh/config)
# ACME Platform Infrastructure Access
# ===========================================

# --- Global Defaults ---

Host *
  AddKeysToAgent yes
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  TCPKeepAlive yes
  Compression yes
  HashKnownHosts yes
  StrictHostKeyChecking ask
  VisualHostKey yes
  LogLevel ERROR

# --- Version Control ---

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_github
  PreferredAuthentications publickey

Host gitlab.acme.dev
  HostName gitlab.internal.acme.dev
  User git
  IdentityFile ~/.ssh/id_ed25519_acme
  Port 2222
  ProxyJump bastion-east

# --- Bastion / Jump Hosts ---

Host bastion-east
  HostName bastion-east.acme.com
  User ops
  IdentityFile ~/.ssh/id_ed25519_acme
  Port 2222
  ForwardAgent no
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600

Host bastion-west
  HostName bastion-west.acme.com
  User ops
  IdentityFile ~/.ssh/id_ed25519_acme
  Port 2222
  ForwardAgent no
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600

