# ===========================================
# ACME Platform - Environment Configuration
# ===========================================
# Copy this to .env.local and fill in secrets.
# NEVER commit .env.local to version control.

# --- Application ---
APP_NAME=acme-platform
APP_ENV=development
APP_PORT=8080
APP_WORKERS=4
APP_LOG_LEVEL=debug
APP_LOG_FORMAT=pretty
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-base64-32

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://acme:localdev@localhost:5432/acme_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=300
DATABASE_STATEMENT_TIMEOUT=30000
DATABASE_SSL_MODE=prefer
# DATABASE_CA_CERT=/etc/ssl/certs/rds-combined-ca-bundle.pem

# --- Cache (Redis) ---
REDIS_URL=redis://localhost:6379/0
REDIS_SENTINEL_URLS=
REDIS_SENTINEL_MASTER=
REDIS_PASSWORD=
REDIS_POOL_SIZE=5
REDIS_TTL_DEFAULT=3600
REDIS_KEY_PREFIX=acme:dev:

# --- Message Queue (Kafka) ---
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=acme-api-dev
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- Authentication ---
JWT_ALGORITHM=RS256
JWT_ISSUER=https://auth.acme.dev
JWT_AUDIENCE=https://api.acme.dev
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
# JWT_PUBLIC_KEY_PATH=/etc/acme/keys/jwt_public.pem
# JWT_PRIVATE_KEY_PATH=/etc/acme/keys/jwt_private.pem

# --- External Services ---
PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=sk_test_placeholder_replace_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_replace_with_real_secret
STRIPE_API_VERSION=2024-11-20

SHIPPING_PROVIDER=shippo
SHIPPO_API_KEY=shippo_test_placeholder

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder
EMAIL_FROM=noreply@acme.dev
EMAIL_REPLY_TO=support@acme.dev

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=acme-uploads-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Observability ---
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=acme-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9102

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Feature Flags ---
FEATURE_FLAGS_PROVIDER=local
# FEATURE_FLAGS_PROVIDER=flagsmith
# FLAGSMITH_URL=http://localhost:8000/api/v1
# FLAGSMITH_KEY=

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20
RATE_LIMIT_BY=ip

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_MAX_AGE=86400
