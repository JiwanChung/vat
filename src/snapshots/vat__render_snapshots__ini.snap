---
source: src/render_snapshots.rs
expression: "render(\"examples/sample.ini\")"
---
  1 │ ; ===========================================
  2 │ ; PostgreSQL Configuration (postgresql.conf)
  3 │ ; Optimized for: 64GB RAM, 16 vCPU, NVMe SSD
  4 │ ; Workload: Mixed OLTP + analytics queries
  5 │ ; ===========================================
  6 │
  7 │ [server]
  8 │ listen_addresses = '*'
  9 │ port = 5432
 10 │ max_connections = 200
 11 │ superuser_reserved_connections = 3
 12 │ unix_socket_directories = /var/run/postgresql
 13 │
 14 │ [memory]
 15 │ ; ~25% of RAM for shared buffers
 16 │ shared_buffers = 16GB
 17 │ ; Per-operation memory
 18 │ work_mem = 256MB
 19 │ ; Maintenance operations (VACUUM, CREATE INDEX)
 20 │ maintenance_work_mem = 2GB
 21 │ ; Temporary buffers for session-local temp tables
 22 │ temp_buffers = 64MB
 23 │ ; Total memory limit for all active hash operations
 24 │ hash_mem_multiplier = 2.0
 25 │
 26 │ [disk]
 27 │ ; 75% of RAM - OS will cache the rest
 28 │ effective_cache_size = 48GB
 29 │ ; Enable huge pages (must configure OS first)
 30 │ huge_pages = try
 31 │ ; Temporary file limit per query
 32 │ temp_file_limit = 10GB
 33 │
 34 │ [wal]
 35 │ ; Write-Ahead Log settings
 36 │ wal_level = replica
 37 │ wal_buffers = 64MB
 38 │ max_wal_size = 4GB
 39 │ min_wal_size = 1GB
 40 │ checkpoint_completion_target = 0.9
 41 │ checkpoint_timeout = 15min
 42 │ ; Synchronous commit for durability
 43 │ synchronous_commit = on
 44 │ ; Full page writes (required for point-in-time recovery)
 45 │ full_page_writes = on
 46 │ wal_compression = zstd
 47 │
 48 │ [replication]
 49 │ max_wal_senders = 10
 50 │ max_replication_slots = 10
 51 │ hot_standby = on
 52 │ hot_standby_feedback = on
 53 │ ; Archive WAL for backup
 54 │ archive_mode = on
 55 │ archive_command = 'pgbackrest --stanza=main archive-push %p'
 56 │
 57 │ [query_planner]
 58 │ ; Planner cost estimates (tuned for NVMe SSD)
 59 │ random_page_cost = 1.1
 60 │ seq_page_cost = 1.0
 61 │ effective_io_concurrency = 200
 62 │ ; Parallel query settings
 63 │ max_parallel_workers_per_gather = 4
 64 │ max_parallel_workers = 8
 65 │ max_parallel_maintenance_workers = 4
 66 │ parallel_tuple_cost = 0.01
 67 │ parallel_setup_cost = 100
 68 │
 69 │ [autovacuum]
 70 │ autovacuum = on
 71 │ autovacuum_max_workers = 4
 72 │ autovacuum_naptime = 30s
 73 │ autovacuum_vacuum_threshold = 50
 74 │ autovacuum_vacuum_scale_factor = 0.05
 75 │ autovacuum_analyze_threshold = 50
 76 │ autovacuum_analyze_scale_factor = 0.025
 77 │ autovacuum_vacuum_cost_delay = 2ms
 78 │ autovacuum_vacuum_cost_limit = 1000
 79 │
 80 │ [logging]
 81 │ ; Log settings for monitoring
 82 │ log_destination = stderr
 83 │ logging_collector = on
 84 │ log_directory = /var/log/postgresql
 85 │ log_filename = postgresql-%Y-%m-%d.log
 86 │ log_rotation_age = 1d
 87 │ log_rotation_size = 256MB
 88 │ log_min_duration_statement = 200
 89 │ log_checkpoints = on
 90 │ log_connections = off
 91 │ log_disconnections = off
 92 │ log_lock_waits = on
 93 │ log_temp_files = 10MB
 94 │ log_autovacuum_min_duration = 1s
 95 │ log_line_prefix = '%m [%p] %q%u@%d '
 96 │
 97 │ [statistics]
 98 │ ; Track IO and function statistics
 99 │ track_activities = on
100 │ track_counts = on
101 │ track_io_timing = on
102 │ track_wal_io_timing = on
103 │ track_functions = all
104 │
105 │ [security]
106 │ ; SSL configuration
107 │ ssl = on
108 │ ssl_cert_file = /etc/ssl/certs/server.crt
109 │ ssl_key_file = /etc/ssl/private/server.key
110 │ ssl_ca_file = /etc/ssl/certs/ca.crt
111 │ ssl_min_protocol_version = TLSv1.3
112 │ password_encryption = scram-sha-256
